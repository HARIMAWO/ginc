#!/usr/bin/env ginc

int add(int a, int b) {
    return a + b;
}

// 正常な呼び出し
//print(add(10, 20));

// ----------------------------------------------------
// 以下のいずれかのコメントを外すと、コンパイルエラーになるはず！
// ----------------------------------------------------

// エラー1: 引数の数が足りない
// add(10);

// エラー2: 引数の数が多すぎる
// add(10, 20, 30);

// エラー3: 引数の型が違う (intの場所にstrを渡している)
add(10, "hello");
