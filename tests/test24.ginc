#!/usr/bin/env ginc

int a = 10;
int b = 20;

// 優先順位のテスト: 算術(+) > 比較(>, !=) > 論理(&&)
// 10 + 20 > 25 (true) AND 10 != 20 (true) -> 1 が出力されるはず
if (a + b > 25 && a != b) {
    print(1);
}

// 剰余(%)と論理否定(!)のテスト
// 10 % 3 は 1。 1 == 0 は false。 !false は true -> 2 が出力されるはず
if (!(a % 3 == 0)) {
    print(2);
}

// 論理和(||)と以下(<=)のテスト
if (a <= 5 || b >= 20) {
    print(3);
}
