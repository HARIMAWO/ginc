#!/usr/bin/env ginc

int add10(int x) {
	return x + 10;
}

// 関数引数に式や負数を渡す
print(add10(-1));     // 9
print(add10(2 + 3));  // 15

// 複合代入演算子
int a = 10;
a += 5;   // 15
a -= 3;   // 12
a *= 2;   // 24
a /= 4;   // 6
a %= 4;   // 2
print(a); // 2

int b = 5;
b <<= 2;  // 20
b >>= 1;  // 10
b |= 1;   // 11
b &= 7;   // 3
b ^= 6;   // 5
print(b); // 5

// ビット反転 ~
print(~0);  // -1
print(~5);  // -6

// 三項演算子 ?:
int x = 10;
int y = (x > 5) ? 100 : 200;
print(y); // 100
int z = (x < 5) ? 100 : (x == 10 ? 300 : 400);
print(z); // 300

// 文字リテラル
int ch = 'A';
print(ch); // 65
int nl = '\n';
print(nl); // 10

// 空文 ;
for (int j = 0; j < 5; j++) ;
;
print(999); // 999
