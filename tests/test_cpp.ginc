#!/usr/bin/env ginc

#include "inc_test.h"
#include "inc_test.h" // #pragma once で二重定義にならない

#define VER 2

int main(void) {
#ifdef __GINC__
	print(BASE_VAL);       // 100
#endif

#if VER == 1
	print(111);
#elif VER == 2 && defined(BASE_VAL)
	print(ADD(10, 20));    // 30
	print(SQR(3 + 2));     // 25
#else
	print(999);
#endif

	int MAKE_VAR(val_, 1) = 77;
	print(val_1);          // 77
	print(STR(hello_cpp)); // hello_cpp
	print(header_add(5, 6)); // 11

#undef BASE_VAL
#ifndef BASE_VAL
	print(555);            // 555
#endif

	int* p = NULL;
	if (p == NULL) {
		print(1);          // 1
	}

	return 0;
}
