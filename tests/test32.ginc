#!/usr/bin/env ginc

int flags = 5; // 0101 (binary)
int mask = 2;  // 0010 (binary)

// 1. ビットAND
int res_and = flags & mask; // 0000 = 0
print(res_and);

// 2. ビットOR
int res_or = flags | mask;  // 0111 = 7
print(res_or);

// 3. ビットXOR
int res_xor = flags ^ mask; // 0111 = 7 (待って、0101 ^ 0010 = 0111 = 7 合ってる)
print(res_xor);

// 4. シフト演算
int shifted = 1 << 3; // 8
print(shifted);
