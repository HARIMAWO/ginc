#!/usr/bin/env ginc

// 6. extern プロトタイプ宣言
extern int add_ext(int a, int b);

class Box {
public:
	int val;
	int get() {
		return this.val;
	}
};

// 5. static ローカル変数
int counter(void) {
	static int count = 0;
	count++;
	return count;
}

int add_ext(int a, int b) {
	return a + b;
}

int main(void) {
	// 1. カンマ演算子
	int a = 0;
	int x = (a = 10, a + 5);
	print(x); // 15

	int sum = 0;
	int i = 0;
	int j = 0;
	for (i = 0, j = 10; i < 3; i++, j--) {
		sum += i + j;
	}
	// i=0,j=10 -> 10; i=1,j=9 -> 10; i=2,j=8 -> 10 => 30
	print(sum); // 30

	// 2. goto & ラベル（前方・後方ジャンプ）
	int g = 0;
	goto skip_init;
	g = 999;
skip_init:
	g = 1;
loop_start:
	if (g < 4) {
		g++;
		goto loop_start;
	}
	print(g); // 4

	// 3. sizeof()
	print(sizeof(char));   // 1
	print(sizeof(int));    // 4
	print(sizeof(double)); // 8
	print(sizeof(int*));   // 8
	int arr[] = {10, 20, 30, 40, 50};
	int len = sizeof(arr) / sizeof(arr[0]);
	print(len); // 5

	// 4. -> アクセス
	Box* b;
	b->val = 77;
	print(b->val);   // 77
	print(b->get()); // 77

	// 5. static ローカル変数
	print(counter()); // 1
	print(counter()); // 2
	print(counter()); // 3

	// 6. extern 関数
	print(add_ext(11, 22)); // 33

	return 0;
}
